{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@datavex/ui-theme": ["../../packages/ui-theme/src/index.ts"],
      "@datavex/ui-theme/*": ["../../packages/ui-theme/src/*"],
      "@/components/ui/*": ["../../packages/ui-theme/src/components/ui/*"],
      "@/lib/utils": ["../../packages/ui-theme/src/lib/utils.ts"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "../../packages/ui-theme/src/**/*"
  ],
  "exclude": ["node_modules"]
}
