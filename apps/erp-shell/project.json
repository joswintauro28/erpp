{
  "name": "erp-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/erp-shell",
  "targets": {
    "dev": {
      "command": "bun run dev",
      "options": {
        "cwd": "apps/erp-shell"
      }
    },
    "build": {
      "command": "bun run build",
      "options": {
        "cwd": "apps/erp-shell"
      },
      "outputs": ["{workspaceRoot}/apps/erp-shell/.next"]
    },
    "start": {
      "command": "bun run start",
      "options": {
        "cwd": "apps/erp-shell"
      }
    },
    "lint": {
      "command": "bun run lint",
      "options": {
        "cwd": "apps/erp-shell"
      }
    }
  }
}
