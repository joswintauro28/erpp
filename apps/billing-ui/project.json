{
  "name": "billing-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/billing-ui",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun next dev --port 3002",
        "cwd": "apps/billing-ui"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/billing-ui"
      },
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/.next"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "apps/billing-ui"
      }
    }
  }
}
