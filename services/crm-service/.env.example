DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/erp_crm
JWT_SECRET=your-secret-key-here
PORT=8001
FRONTEND_URL=http://localhost:3000

# AI — rotate keys quarterly; never commit actual values to git
# Used by lead_discovery scraper (Groq primary, Gemini fallback)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# File migration to MinIO (used by scripts/migrate_files_to_minio.py)
ERP_DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/erp_db
BILLING_DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/erp_billing
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
