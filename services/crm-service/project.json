{
  "name": "crm-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/crm-service",
  "targets": {
    "dev": {
      "command": ".venv\\Scripts\\uvicorn main:app --port 8001 --reload",
      "options": {
        "cwd": "services/crm-service"
      }
    },
    "seed": {
      "command": ".venv\\Scripts\\python scripts/seed_data.py",
      "options": {
        "cwd": "services/crm-service"
      }
    }
  }
}
