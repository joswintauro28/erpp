{
  "name": "crm-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/crm-service",
  "targets": {
    "dev": {
      "command": ".venv/bin/uvicorn app.main:app --port 8001 --reload",
      "options": {
        "cwd": "services/crm-service"
      }
    },
    "seed": {
      "command": ".venv/bin/python scripts/seed_data.py",
      "options": {
        "cwd": "services/crm-service"
      }
    },
    "migrate": {
      "command": ".venv/bin/alembic upgrade head",
      "options": {
        "cwd": "services/crm-service"
      }
    },
    "migration": {
      "command": ".venv/bin/alembic revision --autogenerate -m",
      "options": {
        "cwd": "services/crm-service"
      }
    }
  }
}
