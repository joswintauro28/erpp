{
  "name": "erp-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/erp-service",
  "targets": {
    "dev": {
      "command": ".venv\\Scripts\\uvicorn app.main:app --reload",
      "options": {
        "cwd": "services/erp-service"
      }
    },
    "migrate": {
      "command": ".venv\\Scripts\\alembic upgrade head",
      "options": {
        "cwd": "services/erp-service"
      }
    },
    "seed": {
      "command": ".venv\\Scripts\\python scripts/seed.py",
      "options": {
        "cwd": "services/erp-service"
      }
    }
  }
}
