# Database connection string (PostgreSQL with async engine)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/erp_db

# Security / Authentication keys
JWT_SECRET=change-this-to-a-random-secret-key-123
PORT=8000

# Allowed CORS origins (CORS policy matching your Next.js address)
FRONTEND_URL=http://localhost:3000

# Token Expiration Settings
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Security Policies
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
