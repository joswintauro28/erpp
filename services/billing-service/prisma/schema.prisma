generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

enum InvoiceType {
  receivable
  payable
}

enum GstTreatment {
  intrastate
  interstate
}

enum PaymentMethod {
  Bank_Transfer
  UPI
  Credit_Card
  Cheque
  Cash
}

enum PaymentStatus {
  pending
  cleared
  completed
  failed
  refunded
}

enum NoteStatus {
  draft
  issued
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum RecurringFrequency {
  weekly
  monthly
  quarterly
  yearly
}

enum RecurringStatus {
  active
  paused
  completed
}

model Invoice {
  id              Int            @id @default(autoincrement())
  organizationId  Int            @map("organization_id")
  type            InvoiceType    @default(receivable)
  clientId        Int?           @map("client_id")
  clientName      String?        @map("client_name")
  vendorId        Int?           @map("vendor_id")
  vendorName      String?        @map("vendor_name")
  invoiceNumber   String?        @unique @map("invoice_number")
  status          InvoiceStatus  @default(draft)
  issueDate       DateTime?      @map("issue_date")
  dueDate         DateTime?      @map("due_date")
  subtotal        Decimal        @default(0.00) @db.Decimal(12, 2)
  discount        Decimal        @default(0.00) @db.Decimal(12, 2)
  discountType    String?        @map("discount_type")
  cgst            Decimal        @default(0.00) @db.Decimal(12, 2)
  sgst            Decimal        @default(0.00) @db.Decimal(12, 2)
  igst            Decimal        @default(0.00) @db.Decimal(12, 2)
  taxTotal        Decimal        @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  total           Decimal        @default(0.00) @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue      Decimal        @default(0.00) @map("balance_due") @db.Decimal(12, 2)
  gstTreatment    GstTreatment   @default(intrastate) @map("gst_treatment")
  placeOfSupply   String?        @map("place_of_supply")
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  items     InvoiceItem[]
  payments  Payment[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  dunningRecords DunningRecord[]
  bankMatches BankTransaction[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([vendorId])
  @@map("invoices")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  productId   Int?    @map("product_id")
  description String  @db.Text
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  costPrice   Decimal @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  costSnapshot Json?   @map("cost_snapshot")
  gstRate     Decimal @default(0.00) @map("gst_rate") @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}


model Payment {
  id            Int           @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  invoiceId     Int?          @map("invoice_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod? @map("payment_method")
  paymentDate   DateTime?     @map("payment_date")
  referenceId   String?       @map("reference_id")
  notes         String?       @db.Text
  status        PaymentStatus @default(completed)
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  bankMatches BankTransaction[]

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
  @@index([organizationId, status, paymentDate])
  @@map("payments")
}

model CreditNote {
  id                Int        @id @default(autoincrement())
  organizationId    Int        @map("organization_id")
  invoiceId         Int        @map("invoice_id")
  creditNoteNumber  String?    @map("credit_note_number")
  amount            Decimal    @db.Decimal(12, 2)
  reason            String?    @db.Text
  status            NoteStatus @default(issued)
  issueDate         DateTime?  @map("issue_date")
  createdAt         DateTime   @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model DebitNote {
  id               Int        @id @default(autoincrement())
  organizationId   Int        @map("organization_id")
  invoiceId        Int        @map("invoice_id")
  debitNoteNumber  String?    @map("debit_note_number")
  amount           Decimal    @db.Decimal(12, 2)
  reason           String?    @db.Text
  status           NoteStatus @default(issued)
  issueDate        DateTime?  @map("issue_date")
  createdAt        DateTime   @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("debit_notes")
}

model Quotation {
  id                  Int              @id @default(autoincrement())
  organizationId      Int              @map("organization_id")
  clientId            Int              @map("client_id")
  clientName          String           @map("client_name")
  quoteNumber         String           @unique @map("quote_number")
  total               Decimal          @default(0.00) @db.Decimal(12, 2)
  status              QuotationStatus  @default(draft)
  issueDate           DateTime?        @map("issue_date")
  validUntil          DateTime?        @map("valid_until")
  notes               String?          @db.Text
  convertedInvoiceId  Int?             @map("converted_invoice_id")
  createdAt           DateTime         @default(now()) @map("created_at")

  items QuotationItem[]

  @@index([organizationId])
  @@map("quotations")
}

model QuotationItem {
  id           Int      @id @default(autoincrement())
  quotationId  Int      @map("quotation_id")
  description  String   @db.Text
  quantity     Decimal  @db.Decimal(12, 2)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  gstRate      Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  amount       Decimal  @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model RecurringInvoice {
  id              Int                @id @default(autoincrement())
  organizationId  Int                @map("organization_id")
  clientId        Int                @map("client_id")
  clientName      String             @map("client_name")
  templateName    String             @map("template_name")
  items           Json               @default("[]")
  total           Decimal            @default(0.00) @db.Decimal(12, 2)
  frequency       RecurringFrequency
  nextRun         DateTime           @map("next_run")
  endDate         DateTime?          @map("end_date")
  lastGenerated   DateTime?          @map("last_generated")
  autoEmail       Boolean            @default(false) @map("auto_email")
  status          RecurringStatus    @default(active)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("recurring_invoices")
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

model BankTransaction {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  transactionDate DateTime @map("transaction_date")
  description     String   @db.Text
  reference       String?
  debit           Decimal  @default(0) @db.Decimal(12, 2)
  credit          Decimal  @default(0) @db.Decimal(12, 2)
  balance         Decimal  @default(0) @db.Decimal(12, 2)
  matchedPaymentId Int?    @map("matched_payment_id")
  matchedInvoiceId Int?    @map("matched_invoice_id")
  matchedLedgerEntryId Int? @map("matched_ledger_entry_id")
  classification  String   @default("Unmatched") // Matched, Partial_Match, Unmatched, Duplicate, Exception
  adjustedAmount  Decimal  @default(0) @map("adjusted_amount") @db.Decimal(12, 2)
  reconciliationNotes String? @map("reconciliation_notes") @db.Text
  matchedAt       DateTime? @map("matched_at")
  reconciledAt    DateTime? @map("reconciled_at")
  reconciledBy    String?  @map("reconciled_by")
  importBatch     String   @map("import_batch")
  createdAt       DateTime @default(now()) @map("created_at")

  matchedPayment Payment? @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedInvoice Invoice? @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  matchedLedgerEntry LedgerEntry? @relation(fields: [matchedLedgerEntryId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([matchedPaymentId])
  @@index([matchedInvoiceId])
  @@index([matchedLedgerEntryId])
  @@index([importBatch])
  @@index([organizationId, matchedPaymentId])
  @@map("bank_transactions")
}

model ReconciliationToleranceRule {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @unique @map("organization_id")
  amountTolerance Decimal  @default(0.00) @map("amount_tolerance") @db.Decimal(12, 2)
  dateToleranceDays Int    @default(3) @map("date_tolerance_days")
  matchByReference Boolean @default(true) @map("match_by_reference")
  matchByPaymentMethod Boolean @default(true) @map("match_by_payment_method")
  matchByLedger   Boolean  @default(true) @map("match_by_ledger")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("reconciliation_tolerance_rules")
}

model ReconciliationAuditLog {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  actionType      String   @map("action_type") // AUTO_MATCH, MANUAL_RECONCILE, MANUAL_ADJUSTMENT, UNMATCH
  bankTransactionId Int    @map("bank_transaction_id")
  matchedPaymentId  Int?   @map("matched_payment_id")
  matchedInvoiceId  Int?   @map("matched_invoice_id")
  matchedLedgerEntryId Int? @map("matched_ledger_entry_id")
  adjustedAmount  Decimal? @map("adjusted_amount") @db.Decimal(12, 2)
  notes           String?  @db.Text
  performedBy     String?  @map("performed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([bankTransactionId])
  @@map("reconciliation_audit_logs")
}

model ReconciliationReport {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  batch           String
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  totalBank       Decimal  @default(0) @map("total_bank") @db.Decimal(12, 2)
  totalMatched    Decimal  @default(0) @map("total_matched") @db.Decimal(12, 2)
  totalUnmatched  Decimal  @default(0) @map("total_unmatched") @db.Decimal(12, 2)
  transactionCount Int    @default(0) @map("transaction_count")
  matchedCount    Int      @default(0) @map("matched_count")
  status          String   @default("draft")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("reconciliation_reports")
}

model FiscalPeriod {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  label           String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isClosed        Boolean  @default(false) @map("is_closed")
  closedAt        DateTime? @map("closed_at")
  closedBy        Int?     @map("closed_by")
  createdAt       DateTime @default(now()) @map("created_at")
  journals        Journal[]


  @@index([organizationId])
  @@index([organizationId, isClosed])
  @@map("fiscal_periods")
}

model CloseAuditLog {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  periodId        Int      @map("period_id")
  action          String   // CLOSE, REOPEN, VALIDATION_FAILED, REOPEN_REQUEST
  performedBy     Int      @map("performed_by")
  details         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([periodId])
  @@map("close_audit_logs")
}

model CloseSignOff {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  periodId        Int      @map("period_id")
  role            String   // e.g., Controller, CFO
  userId          Int      @map("user_id")
  signedAt        DateTime @default(now()) @map("signed_at")
  comments        String?  @db.Text

  @@unique([periodId, role])
  @@index([organizationId])
  @@map("close_sign_offs")
}

model ReopenRequest {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  periodId        Int      @map("period_id")
  reason          String   @db.Text
  status          String   @default("Pending") // Pending, Approved, Rejected
  requestedBy     Int      @map("requested_by")
  approvedBy      Int?     @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  comments        String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([periodId])
  @@map("reopen_requests")
}

model DunningRecord {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  invoiceId       Int      @map("invoice_id")
  level           Int      @default(1)
  daysOverdue     Int      @map("days_overdue")
  notifiedAt      DateTime @default(now()) @map("notified_at")
  notes           String?  @db.Text

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([organizationId, level])
  @@map("dunning_records")
}

model Account {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  code            String
  name            String
  type            AccountType
  subType         String?  @map("sub_type")
  description     String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  balance         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  accountMappings AccountMapping[]
  journalLines  JournalLine[]



  @@index([organizationId])
  @@unique([organizationId, code])
  @@map("accounts")
}

model Expense {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  accountId       Int      @map("account_id")
  amount          Decimal  @db.Decimal(12, 2)
  category        String?
  description     String?  @db.Text
  date            DateTime @default(now())
  paymentMethod   String?  @map("payment_method")
  reference       String?
  status          String   @default("recorded")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([organizationId])
  @@index([accountId])
  @@map("expenses")
}

model LedgerEntry {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  accountId       Int      @map("account_id")
  entryDate       DateTime @map("entry_date")
  description     String   @db.Text
  debit           Decimal  @default(0) @db.Decimal(12, 2)
  credit          Decimal  @default(0) @db.Decimal(12, 2)
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  dimensions      Json?
  createdAt       DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])
  bankMatches BankTransaction[]

  @@index([organizationId])
  @@index([accountId])
  @@index([entryDate])
  @@map("ledger_entries")
}

model AccountMapping {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  role           String   // ROLE_COGS, ROLE_INVENTORY_ASSET, ROLE_ACCOUNTS_RECEIVABLE, ROLE_SALES_REVENUE, ROLE_SALES_RETURNS
  accountId      Int      @map("account_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("account_mappings")
}

model OrgAccountingConfig {
  id                      Int      @id @default(autoincrement())
  organizationId          Int      @unique @map("organization_id")
  recognitionPolicy       String   @default("STRAIGHT_LINE") @map("recognition_policy")
  sspPolicy               String   @default("RELATIVE_SSP") @map("ssp_policy")
  fiscalCalendarType      String   @default("CALENDAR_YEAR") @map("fiscal_calendar_type")
  fxPolicy                String   @default("HISTORICAL_ACTIVATION") @map("fx_policy")
  closedPeriodBehavior    String   @default("POST_NEXT_OPEN") @map("closed_period_behavior")
  contractAmendmentPolicy String   @default("PROSPECTIVE") @map("contract_amendment_policy")
  revenueReversalPolicy   String   @default("REVERSE_TO_DEFERRED") @map("revenue_reversal_policy")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("org_accounting_configs")
}

model InboxRecord {
  id                Int      @id @default(autoincrement())
  organizationId    Int      @map("organization_id")
  idempotencyKey    String   @unique @map("idempotency_key")
  eventType         String   @map("event_type")
  payload           Json
  processingStatus  String   @default("RECEIVED") @map("processing_status") // RECEIVED, PROCESSING, COMPLETED, FAILED
  retryCount        Int      @default(0) @map("retry_count")
  receivedAt        DateTime @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")

  @@index([organizationId])
  @@index([processingStatus])
  @@map("inbox_records")
}

model CogsPosting {
  id                      Int      @id @default(autoincrement())
  organizationId          Int      @map("organization_id")
  idempotencyKey          String   @unique @map("idempotency_key")
  invoiceId               Int?     @map("invoice_id")
  shipmentReference       String?  @map("shipment_reference")
  status                  String   @default("Posted") // Pending, Processing, Posted, Failed, Reversed, Cancelled
  totalCost               Decimal  @map("total_cost") @db.Decimal(12, 2)
  warehouseId             Int?     @map("warehouse_id")
  batchNumber             String?  @map("batch_number")
  serialNumber            String?  @map("serial_number")
  snapshotData            Json     @map("snapshot_data")
  snapshotHash            String?  @map("snapshot_hash")
  signature               String?  @map("signature")
  createdAt               DateTime @default(now()) @map("created_at")

  auditLogs CogsAuditLog[]

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
  @@map("cogs_postings")
}

model CogsAuditLog {
  id             Int         @id @default(autoincrement())
  organizationId Int         @map("organization_id")
  postingId      Int?        @map("posting_id")
  action         String
  details        String      @db.Text
  performedBy    String      @default("system") @map("performed_by")
  createdAt      DateTime    @default(now()) @map("created_at")

  cogsPosting CogsPosting? @relation(fields: [postingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([postingId])
  @@map("cogs_audit_logs")
}

// ==========================================
// SSP CATALOG & PRICING
// ==========================================

model SspCatalog {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @map("organization_id")
  productId       Int       @map("product_id")
  productName     String    @map("product_name")
  sspType         String    @map("ssp_type")
  basePrice       Decimal   @db.Decimal(12, 2) @map("base_price")
  region          String?
  priceListTier   String?   @map("price_list_tier")
  effectiveFrom   DateTime? @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  version         Int       @default(1)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([productId])
  @@index([productId, isActive])
  @@index([productId, effectiveFrom, effectiveTo])
  @@map("ssp_catalog")
}

// ==========================================
// REVENUE RECOGNITION (ASC 606 / IFRS 15)
// ==========================================

model BillingContract {
  id                  Int                     @id @default(autoincrement())
  organizationId      Int                     @map("organization_id")
  externalContractId  String                  @unique @map("external_contract_id")
  contractNumber      String                  @map("contract_number")
  clientId            Int                     @map("client_id")
  clientName          String                  @map("client_name")
  status              String                  @default("Draft")
  startDate           DateTime                @map("start_date")
  endDate             DateTime                @map("end_date")
  baseContractValue   Decimal                 @db.Decimal(12, 2) @map("base_contract_value")
  variableValue       Decimal                 @default(0.00) @db.Decimal(12, 2) @map("variable_value")
  totalAllocatedValue Decimal                 @db.Decimal(12, 2) @map("total_allocated_value")
  currency            String                  @default("INR")
  exchangeRate        Decimal                 @default(1.000000) @db.Decimal(12, 6) @map("exchange_rate")
  currentVersion      Int                     @default(1) @map("current_version")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  performanceObligations PerformanceObligation[]
  revenueSchedules       RevenueSchedule[]
  variableConsiderations VariableConsideration[]

  @@index([organizationId])
  @@index([status])
  @@map("billing_contracts")
}

model PerformanceObligation {
  id                        Int                     @id @default(autoincrement())
  organizationId            Int                     @map("organization_id")
  contractId                Int                     @map("contract_id")
  externalObligationId      String                  @unique @map("external_obligation_id")
  obligationNumber          String                  @map("obligation_number")
  name                      String
  productId                 Int?                    @map("product_id")
  productName               String?                 @map("product_name")
  transactionAmount         Decimal                 @db.Decimal(12, 2) @map("transaction_amount")
  allocatedAmount           Decimal                 @db.Decimal(12, 2) @map("allocated_amount")
  deferredBalance           Decimal                 @default(0.00) @db.Decimal(12, 2) @map("deferred_balance")
  recognizedBalance         Decimal                 @default(0.00) @db.Decimal(12, 2) @map("recognized_balance")
  recognitionMethod         String                  @map("recognition_method")
  recognitionTrigger        String                  @map("recognition_trigger")
  prerequisiteObligationId  Int?                    @map("prerequisite_obligation_id")
  status                    String                  @default("NotStarted")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  contract          BillingContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  revenueSchedules  RevenueSchedule[]
  manualAdjustments ManualAdjustment[]

  @@index([organizationId])
  @@index([contractId])
  @@map("performance_obligations")
}

model VariableConsideration {
  id                  Int                     @id @default(autoincrement())
  organizationId      Int                     @map("organization_id")
  contractId          Int                     @map("contract_id")
  type                String
  estimatedAmount     Decimal                 @db.Decimal(12, 2) @map("estimated_amount")
  confidenceLevel     Decimal                 @default(1.00) @db.Decimal(3, 2) @map("confidence_level")
  isConstraintApplied Boolean                 @default(false) @map("is_constraint_applied")
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  contract BillingContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contractId])
  @@map("variable_considerations")
}

model RevenueSchedule {
  id                      Int                     @id @default(autoincrement())
  organizationId          Int                     @map("organization_id")
  contractId              Int                     @map("contract_id")
  performanceObligationId Int                     @map("performance_obligation_id")
  version                 Int                     @default(1)
  isCurrent               Boolean                 @default(true) @map("is_current")
  status                  String                  @default("Active")
  rebalancedFromVersion   Int?                    @map("rebalanced_from_version")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  contract   BillingContract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  obligation PerformanceObligation @relation(fields: [performanceObligationId], references: [id], onDelete: Cascade)
  items      RevenueScheduleItem[]
  auditLogs  RevenueAuditLog[]

  @@unique([performanceObligationId, version])
  @@index([organizationId])
  @@map("revenue_schedules")
}

model RevenueScheduleItem {
  id                  Int                     @id @default(autoincrement())
  organizationId      Int                     @map("organization_id")
  scheduleId          Int                     @map("schedule_id")
  periodStartDate     DateTime                @map("period_start_date")
  periodEndDate       DateTime                @map("period_end_date")
  recognitionDate     DateTime                @map("recognition_date")
  nextRecognitionDate DateTime?               @map("next_recognition_date")
  amount              Decimal                 @db.Decimal(12, 2)
  status              String                  @default("Scheduled")
  ledgerEntryId       Int?                    @map("ledger_entry_id")
  cashLedgerEntryId   Int?                    @map("cash_ledger_entry_id")
  idempotencyKey      String                  @unique @map("idempotency_key")
  postedAt            DateTime?               @map("posted_at")
  failureReason       String?                 @map("failure_reason") @db.Text
  sourceEventId       String?                 @map("source_event_id")
  sourceEventType     String?                 @map("source_event_type")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  schedule RevenueSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([nextRecognitionDate, status])
  @@map("revenue_schedule_items")
}

model ManualAdjustment {
  id                      Int                     @id @default(autoincrement())
  organizationId          Int                     @map("organization_id")
  performanceObligationId Int                     @map("performance_obligation_id")
  adjustmentType          String                  @map("adjustment_type")
  originalValue           String?                 @map("original_value") @db.Text
  newValue                String?                 @map("new_value") @db.Text
  reason                  String                  @db.Text
  status                  String                  @default("Pending")
  requestedBy             String                  @map("requested_by")
  currentLevelIndex       Int                     @default(0) @map("current_level_index")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  obligation     PerformanceObligation  @relation(fields: [performanceObligationId], references: [id], onDelete: Cascade)
  approvalSteps  WorkflowApprovalStep[]

  @@index([organizationId])
  @@map("manual_adjustments")
}

model WorkflowApprovalStep {
  id            Int                     @id @default(autoincrement())
  adjustmentId  Int                     @map("adjustment_id")
  level         Int
  role          String
  approverEmail String?                 @map("approver_email")
  status        String                  @default("Pending")
  comments      String?                 @db.Text
  actionedAt    DateTime?               @map("actioned_at")

  adjustment ManualAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@unique([adjustmentId, level])
  @@map("workflow_approval_steps")
}

model ForecastSnapshot {
  id                      Int                     @id @default(autoincrement())
  organizationId          Int                     @map("organization_id")
  forecastVersion         String                  @map("forecast_version")
  generatedTimestamp      DateTime                @default(now()) @map("generated_timestamp")
  forecastParameters      Json                    @map("forecast_parameters")
  recognitionAssumptions  Json                    @map("recognition_assumptions")
  totalProjectedAmount    Decimal                 @db.Decimal(15, 2) @map("total_projected_amount")
  createdAt               DateTime                @default(now()) @map("created_at")

  records ForecastSnapshotItem[]

  @@unique([organizationId, forecastVersion])
  @@map("forecast_snapshots")
}

model ForecastSnapshotItem {
  id                      Int                     @id @default(autoincrement())
  snapshotId              Int                     @map("snapshot_id")
  targetMonth             DateTime                @map("target_month")
  clientName              String?                 @map("client_name")
  contractNumber          String?                 @map("contract_number")
  projectedRevenue        Decimal                 @db.Decimal(12, 2) @map("projected_revenue")
  deferredExpectedBalance Decimal                 @db.Decimal(12, 2) @map("deferred_expected_balance")

  snapshot ForecastSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("forecast_snapshot_items")
}

model OutboxRecord {
  id              Int                     @id @default(autoincrement())
  organizationId  Int                     @map("organization_id")
  eventId         String                  @unique @map("event_id")
  eventType       String                  @map("event_type")
  payload         Json
  schemaVersion   String                  @map("schema_version")
  status          String                  @default("PENDING")
  attempts        Int                     @default(0)
  createdAt       DateTime                @default(now()) @map("created_at")
  publishedAt     DateTime?               @map("published_at")
  lastAttemptAt   DateTime?               @map("last_attempt_at")
  failureReason   String?                 @db.Text

  @@index([status])
  @@index([createdAt])
  @@map("outbox_records")
}

model RevenueAuditLog {
  id              Int                     @id @default(autoincrement())
  organizationId  Int                     @map("organization_id")
  scheduleId      Int?                    @map("schedule_id")
  action          String
  details         String                  @db.Text
  performedBy     String                  @default("system") @map("performed_by")
  createdAt       DateTime                @default(now()) @map("created_at")

  schedule RevenueSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("revenue_audit_logs")
}

model FinancialReportTemplate {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  reportType     String   @map("report_type")
  structure      Json     @map("structure")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("financial_report_templates")
}

model FinancialReport {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String
  reportType     String   @map("report_type")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  status         String   @default("Draft")
  payload        Json
  version        Int      @default(1)
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([organizationId, reportType])
  @@map("financial_reports")
}

model FinancialSnapshot {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  periodId       Int?     @map("period_id")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  dimensionHash  String   @map("dimension_hash")
  accountCode    String   @map("account_code")
  debitSum       Decimal  @db.Decimal(12, 2) @map("debit_sum")
  creditSum      Decimal  @db.Decimal(12, 2) @map("credit_sum")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("financial_snapshots")
}

enum PostingStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  POSTED
  REVERSED
  ARCHIVED
}

model Journal {
  id               Int           @id @default(autoincrement())
  organizationId   Int           @map("organization_id")
  journalNumber    String        @unique @map("journal_number")
  postingDate      DateTime      @map("posting_date")
  fiscalPeriodId   Int           @map("fiscal_period_id")
  status           PostingStatus @default(DRAFT)
  templateType     String        @map("template_type")
  sourceType       String        @map("source_type")
  sourceId         Int           @map("source_id")
  batchId          Int?          @map("batch_id")
  currency         String        @default("USD")
  exchangeRate     Decimal       @default(1.000000) @map("exchange_rate") @db.Decimal(12, 6)
  baseAmount       Decimal       @map("base_amount") @db.Decimal(12, 2)
  reportingAmount  Decimal       @map("reporting_amount") @db.Decimal(12, 2)
  createdBy        String        @map("created_by")
  reversalRefId    Int?          @unique @map("reversal_ref_id")
  reopenedRefId    Int?          @unique @map("reopened_ref_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  lines            JournalLine[]
  batch            PostingBatch? @relation(fields: [batchId], references: [id])
  fiscalPeriod     FiscalPeriod  @relation(fields: [fiscalPeriodId], references: [id])
  
  @@index([organizationId, status])
  @@index([sourceType, sourceId])
  @@map("journals")
}

model JournalLine {
  id             Int      @id @default(autoincrement())
  journalId      Int      @map("journal_id")
  accountId      Int      @map("account_id")
  debit          Decimal  @default(0.00) @db.Decimal(12, 2)
  credit         Decimal  @default(0.00) @db.Decimal(12, 2)
  dimensions     Json?    
  reconciliationStatus String @default("UNRECONCILED") @map("reconciliation_status")
  
  journal        Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account        Account  @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

model PostingBatch {
  id             Int           @id @default(autoincrement())
  organizationId Int           @map("organization_id")
  batchCode      String        @unique @map("batch_code")
  lifecycle      String        @default("QUEUED")
  startedAt      DateTime?     @map("started_at")
  completedAt    DateTime?     @map("completed_at")
  failureLog     String?       @map("failure_log") @db.Text
  journals       Journal[]

  @@map("posting_batches")
}

model OrgPostingConfig {
  id                      Int      @id @default(autoincrement())
  organizationId          Int      @unique @map("organization_id")
  suspenseAccountStrategy String   @default("REJECT_POSTING") @map("suspense_strategy")
  suspenseAccountId       Int?     @map("suspense_account_id")
  numberingPrefix         String   @default("JV-") @map("numbering_prefix")
  requiredDimensions      Json?    @map("required_dimensions")
  
  @@map("org_posting_configs")
}


