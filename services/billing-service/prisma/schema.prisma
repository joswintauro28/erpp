generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

enum InvoiceType {
  receivable
  payable
}

enum GstTreatment {
  intrastate
  interstate
}

enum PaymentMethod {
  Bank_Transfer
  UPI
  Credit_Card
  Cheque
  Cash
}

enum PaymentStatus {
  pending
  cleared
  completed
  failed
  refunded
}

enum NoteStatus {
  draft
  issued
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum RecurringFrequency {
  weekly
  monthly
  quarterly
  yearly
}

enum RecurringStatus {
  active
  paused
  completed
}

model Invoice {
  id              Int            @id @default(autoincrement())
  organizationId  Int            @map("organization_id")
  type            InvoiceType    @default(receivable)
  clientId        Int?           @map("client_id")
  clientName      String?        @map("client_name")
  vendorId        Int?           @map("vendor_id")
  vendorName      String?        @map("vendor_name")
  invoiceNumber   String?        @unique @map("invoice_number")
  status          InvoiceStatus  @default(draft)
  issueDate       DateTime?      @map("issue_date")
  dueDate         DateTime?      @map("due_date")
  subtotal        Decimal        @default(0.00) @db.Decimal(12, 2)
  discount        Decimal        @default(0.00) @db.Decimal(12, 2)
  discountType    String?        @map("discount_type")
  cgst            Decimal        @default(0.00) @db.Decimal(12, 2)
  sgst            Decimal        @default(0.00) @db.Decimal(12, 2)
  igst            Decimal        @default(0.00) @db.Decimal(12, 2)
  taxTotal        Decimal        @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  total           Decimal        @default(0.00) @db.Decimal(12, 2)
  paidAmount      Decimal        @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue      Decimal        @default(0.00) @map("balance_due") @db.Decimal(12, 2)
  gstTreatment    GstTreatment   @default(intrastate) @map("gst_treatment")
  placeOfSupply   String?        @map("place_of_supply")
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  items     InvoiceItem[]
  payments  Payment[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  dunningRecords DunningRecord[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([vendorId])
  @@map("invoices")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  productId   Int?    @map("product_id")
  description String  @db.Text
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  costPrice   Decimal @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  gstRate     Decimal @default(0.00) @map("gst_rate") @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  invoiceId     Int?          @map("invoice_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod? @map("payment_method")
  paymentDate   DateTime?     @map("payment_date")
  referenceId   String?       @map("reference_id")
  notes         String?       @db.Text
  status        PaymentStatus @default(completed)
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  bankMatches BankTransaction[]

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
  @@index([organizationId, status, paymentDate])
  @@map("payments")
}

model CreditNote {
  id                Int        @id @default(autoincrement())
  organizationId    Int        @map("organization_id")
  invoiceId         Int        @map("invoice_id")
  creditNoteNumber  String?    @map("credit_note_number")
  amount            Decimal    @db.Decimal(12, 2)
  reason            String?    @db.Text
  status            NoteStatus @default(issued)
  issueDate         DateTime?  @map("issue_date")
  createdAt         DateTime   @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model DebitNote {
  id               Int        @id @default(autoincrement())
  organizationId   Int        @map("organization_id")
  invoiceId        Int        @map("invoice_id")
  debitNoteNumber  String?    @map("debit_note_number")
  amount           Decimal    @db.Decimal(12, 2)
  reason           String?    @db.Text
  status           NoteStatus @default(issued)
  issueDate        DateTime?  @map("issue_date")
  createdAt        DateTime   @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("debit_notes")
}

model Quotation {
  id                  Int              @id @default(autoincrement())
  organizationId      Int              @map("organization_id")
  clientId            Int              @map("client_id")
  clientName          String           @map("client_name")
  quoteNumber         String           @unique @map("quote_number")
  total               Decimal          @default(0.00) @db.Decimal(12, 2)
  status              QuotationStatus  @default(draft)
  issueDate           DateTime?        @map("issue_date")
  validUntil          DateTime?        @map("valid_until")
  notes               String?          @db.Text
  convertedInvoiceId  Int?             @map("converted_invoice_id")
  createdAt           DateTime         @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("quotations")
}

model RecurringInvoice {
  id              Int                @id @default(autoincrement())
  organizationId  Int                @map("organization_id")
  clientId        Int                @map("client_id")
  clientName      String             @map("client_name")
  templateName    String             @map("template_name")
  items           Json               @default("[]")
  total           Decimal            @default(0.00) @db.Decimal(12, 2)
  frequency       RecurringFrequency
  nextRun         DateTime           @map("next_run")
  endDate         DateTime?          @map("end_date")
  lastGenerated   DateTime?          @map("last_generated")
  autoEmail       Boolean            @default(false) @map("auto_email")
  status          RecurringStatus    @default(active)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("recurring_invoices")
}

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

model BankTransaction {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  transactionDate DateTime @map("transaction_date")
  description     String   @db.Text
  reference       String?
  debit           Decimal  @default(0) @db.Decimal(12, 2)
  credit          Decimal  @default(0) @db.Decimal(12, 2)
  balance         Decimal  @default(0) @db.Decimal(12, 2)
  matchedPaymentId Int?    @map("matched_payment_id")
  matchedAt       DateTime? @map("matched_at")
  importBatch     String   @map("import_batch")
  createdAt       DateTime @default(now()) @map("created_at")

  matchedPayment Payment? @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([matchedPaymentId])
  @@index([importBatch])
  @@index([organizationId, matchedPaymentId])
  @@map("bank_transactions")
}

model ReconciliationReport {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  batch           String
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  totalBank       Decimal  @default(0) @map("total_bank") @db.Decimal(12, 2)
  totalMatched    Decimal  @default(0) @map("total_matched") @db.Decimal(12, 2)
  totalUnmatched  Decimal  @default(0) @map("total_unmatched") @db.Decimal(12, 2)
  transactionCount Int    @default(0) @map("transaction_count")
  matchedCount    Int      @default(0) @map("matched_count")
  status          String   @default("draft")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("reconciliation_reports")
}

model FiscalPeriod {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  label           String
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isClosed        Boolean  @default(false) @map("is_closed")
  closedAt        DateTime? @map("closed_at")
  closedBy        Int?     @map("closed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([organizationId, isClosed])
  @@map("fiscal_periods")
}

model DunningRecord {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  invoiceId       Int      @map("invoice_id")
  level           Int      @default(1)
  daysOverdue     Int      @map("days_overdue")
  notifiedAt      DateTime @default(now()) @map("notified_at")
  notes           String?  @db.Text

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([organizationId, level])
  @@map("dunning_records")
}

model Account {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  code            String
  name            String
  type            AccountType
  subType         String?  @map("sub_type")
  description     String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  balance         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  @@index([organizationId])
  @@unique([organizationId, code])
  @@map("accounts")
}

model Expense {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  accountId       Int      @map("account_id")
  amount          Decimal  @db.Decimal(12, 2)
  category        String?
  description     String?  @db.Text
  date            DateTime @default(now())
  paymentMethod   String?  @map("payment_method")
  reference       String?
  status          String   @default("recorded")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([organizationId])
  @@index([accountId])
  @@map("expenses")
}

model LedgerEntry {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @map("organization_id")
  accountId       Int      @map("account_id")
  entryDate       DateTime @map("entry_date")
  description     String   @db.Text
  debit           Decimal  @default(0) @db.Decimal(12, 2)
  credit          Decimal  @default(0) @db.Decimal(12, 2)
  referenceType   String?  @map("reference_type")
  referenceId     Int?     @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([organizationId])
  @@index([accountId])
  @@index([entryDate])
  @@map("ledger_entries")
}
