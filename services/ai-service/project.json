{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/ai-service",
  "projectType": "application",
  "tags": ["backend", "python", "ai"],
  "targets": {
    "dev": {
      "command": ".venv\\Scripts\\uvicorn app.main:app --reload --port 8005",
      "options": {
        "cwd": "services/ai-service"
      }
    },
    "migrate": {
      "command": ".venv\\Scripts\\alembic upgrade head",
      "options": {
        "cwd": "services/ai-service"
      }
    }
  }
}
