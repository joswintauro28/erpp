# DATAVEX AI Service — Environment Variables
# Copy to .env and fill in actual values

# Server
PORT=8005

# Database
DATABASE_URL=postgresql+asyncpg://datavex:datavex@localhost:5432/erp_ai

# JWT (must match core-iam JWT_SECRET)
JWT_SECRET=development-jwt-secret-key-123

# LLM Provider
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=

# Service URLs (for context providers)
CRM_SERVICE_URL=http://localhost:8001
BILLING_SERVICE_URL=http://localhost:8003
INVENTORY_SERVICE_URL=http://localhost:8004

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3004

# Limits
MAX_INPUT_LENGTH=4000
MAX_HISTORY_MESSAGES=10
