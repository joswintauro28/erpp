# ──────────────────────────────────────────────
# DATAVEX AI Service — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env with real secrets.

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/erp_ai

# ── JWT (must match core-iam) ────────────────
JWT_SECRET=your-secret-key-here  # Rotate regularly; must match all services
JWT_ALGORITHM=HS256

# ── LLM Provider ─────────────────────────────
# Options: "groq" (default) | "gemini"
AI_PROVIDER=groq

# Groq (https://console.groq.com — free tier available)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (https://aistudio.google.com — free tier available)
GEMINI_API_KEY=

# ── Inter-service URLs ────────────────────────
CRM_SERVICE_URL=http://localhost:8001
BILLING_SERVICE_URL=http://localhost:8003
INVENTORY_SERVICE_URL=http://localhost:8004

# ── App ───────────────────────────────────────
PORT=8005
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3004

# ── Rate Limiting ─────────────────────────────
AI_RATE_LIMIT=30/minute
MAX_INPUT_LENGTH=4000
