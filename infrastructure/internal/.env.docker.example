# ══════════════════════════════════════════════════════════════════════════════
# DATAVEX ERP — Production / Internal Deployment Environment
# ══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Copy this file:  cp .env.docker.example .env.docker
#   2. Replace ALL placeholder values (marked with <...>) with real secrets.
#   3. Generate strong passwords:
#        openssl rand -base64 32        (for passwords)
#        openssl rand -hex 32           (for JWT secret)
#   4. NEVER commit .env.docker to version control.
#
# DOMAIN CONFIGURATION:
#   Replace erp.datavex.ai with your actual domain once confirmed with infra.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Deployment Mode ────────────────────────────────────────────────────────
# "subdomain" for local dev (*.erp.local) or subdomain-based production.
# "single-domain" for path-based production (company.com/crm, /billing, etc.)
DEPLOY_MODE=single-domain
# Production domain — used by nginx SSL certs and RustFS reverse proxy.
MAIN_DOMAIN=erp.datavex.ai

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>

# ─── RabbitMQ Message Broker ────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# CRITICAL: All backend services MUST share the same JWT secret.
# Generate with: openssl rand -hex 32
JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET_HERE>

# ─── Domain / URLs ──────────────────────────────────────────────────────────
# The base domain for all workstations. A DNS A record for the domain
# must point to the VM's public IP (e.g. 161.248.22.228).
DOMAIN=erp.datavex.ai
SHELL_APP_URL=http://${DOMAIN}/admin
CRM_APP_URL=http://${DOMAIN}/crm
BILLING_APP_URL=http://${DOMAIN}/billing
INVENTORY_APP_URL=http://${DOMAIN}/inventory

# ─── RustFS Object Storage ──────────────────────────────────────────────────
# Credentials for both RustFS server and erp-service S3 client.
RUSTFS_ACCESS_KEY=datavex-rustfs-admin
RUSTFS_SECRET_KEY=<GENERATE_STRONG_PASSWORD_HERE>
# Public URL — used by erp-service for presigned URL generation.
RUSTFS_SERVER_URL=http://rustfs.${DOMAIN}

# ─── Cookie Domain ──────────────────────────────────────────────────────────
# Must match the domain so SSO cookies work across workstations.
# Leading dot allows cookie to be sent to all subdomains.
COOKIE_DOMAIN=.${DOMAIN}
# Cookie path - use "/" for single-domain mode to work across all paths
COOKIE_PATH=/

# ─── External API Access (from frontend containers) ────────────────────────
# These are internal Docker network URLs — container names resolve directly.
BACKEND_API_URL=http://erp-service:8000
IAM_API_URL=http://core-iam:8002
BILLING_API_URL=http://billing-service:8003
CRM_API_URL=http://crm-service:8001
INVENTORY_API_URL=http://inventory-service:8004
AI_API_URL=http://ai-service:8005

# ─── Inter-Service URLs (backend → backend) ────────────────────────────────
BILLING_SERVICE_URL=http://billing-service:8003/api
INVENTORY_SERVICE_URL=http://inventory-service:8004
CRM_SERVICE_URL=http://crm-service:8001

# ─── ERP Service Public RustFS URL ─────────────────────────────────────────
# Browsers use this to reach RustFS for file uploads/downloads.
# Must be resolvable from the user's browser.
RUSTFS_PUBLIC_URL=http://rustfs.${DOMAIN}

# ─── Frontend Build Args ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SHELL_APP_URL=http://${DOMAIN}/admin
NEXT_PUBLIC_APP_URL=http://${DOMAIN}/admin
NEXT_PUBLIC_BILLING_APP_URL=http://${DOMAIN}/billing
NEXT_PUBLIC_CRM_APP_URL=http://${DOMAIN}/crm
NEXT_PUBLIC_INVENTORY_APP_URL=http://${DOMAIN}/inventory

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for backend CORS headers.
# In single-domain mode, all workstations share the same origin.
CORS_ORIGINS=http://${DOMAIN}

# ─── AI / LLM Configuration ────────────────────────────────────────────────
# Provider: "groq" (default) or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=<GENERATE_GROQ_API_KEY_HERE>
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=<GENERATE_GEMINI_API_KEY_HERE>