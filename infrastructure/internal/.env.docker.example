# ══════════════════════════════════════════════════════════════════════════════
# DATAVEX ERP — Production / Internal Deployment Environment
# ══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Copy this file:  cp .env.docker.example .env.docker
#   2. Replace ALL placeholder values (marked with <...>) with real secrets.
#   3. Generate strong passwords:
#        openssl rand -base64 32        (for passwords)
#        openssl rand -hex 32           (for JWT secret)
#   4. NEVER commit .env.docker to version control.
#
# DOMAIN CONFIGURATION:
#   Replace erp.datavex.com with your actual domain once confirmed with infra.
#   All *.erp.datavex.com A records must point to the VM's public IP.
# ══════════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# CRITICAL: All backend services MUST share the same JWT secret.
# Generate with: openssl rand -hex 32
JWT_SECRET=<GENERATE_64_CHAR_HEX_SECRET_HERE>

# ─── MinIO Object Storage ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<GENERATE_STRONG_PASSWORD_HERE>

# ─── Domain / URLs ──────────────────────────────────────────────────────────
# The base domain for all workstations. A DNS A record for each subdomain
# must point to the VM's public IP (e.g. 161.248.22.228).
DOMAIN=erp.datavex.com
SHELL_APP_URL=http://app.${DOMAIN}
CRM_APP_URL=http://crm.${DOMAIN}
BILLING_APP_URL=http://billing.${DOMAIN}
INVENTORY_APP_URL=http://inventory.${DOMAIN}

# ─── Cookie Domain ──────────────────────────────────────────────────────────
# Must match the domain so SSO cookies work across workstations.
COOKIE_DOMAIN=erp.datavex.com

# ─── External API Access (from frontend containers) ────────────────────────
# These are internal Docker network URLs — container names resolve directly.
BACKEND_API_URL=http://erp-service:8000
IAM_API_URL=http://core-iam:8002
BILLING_API_URL=http://billing-service:8003
CRM_API_URL=http://crm-service:8001
INVENTORY_API_URL=http://inventory-service:8004

# ─── Inter-Service URLs (backend → backend) ────────────────────────────────
BILLING_SERVICE_URL=http://billing-service:8003/api
INVENTORY_SERVICE_URL=http://inventory-service:8004
CRM_SERVICE_URL=http://crm-service:8001

# ─── ERP Service Public MinIO URL ──────────────────────────────────────────
# Browsers use this to reach MinIO for file uploads/downloads.
# Must be resolvable from the user's browser.
MINIO_PUBLIC_URL=http://minio.${DOMAIN}

# ─── Frontend Build Args ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SHELL_APP_URL=${SHELL_APP_URL}
NEXT_PUBLIC_APP_URL=${SHELL_APP_URL}
NEXT_PUBLIC_BILLING_APP_URL=${BILLING_APP_URL}
NEXT_PUBLIC_CRM_APP_URL=${CRM_APP_URL}
NEXT_PUBLIC_INVENTORY_APP_URL=${INVENTORY_APP_URL}

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for backend CORS headers.
CORS_ORIGINS=${SHELL_APP_URL},${CRM_APP_URL},${BILLING_APP_URL},${INVENTORY_APP_URL}

# ─── AI Keys (optional) ────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
