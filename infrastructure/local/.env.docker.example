# ─────────────────────────────────────────────────────
# DATAVEX ERP — Local Docker Environment Variables
# ─────────────────────────────────────────────────────
# Copy this file to .env.docker and customize.
# NEVER commit .env.docker with real secrets.

# ─── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres

# ─── Security & Authentication ───────────────────────
# CRITICAL: All backend services MUST share the same JWT secret.
# Rotate regularly; never use default in production.
JWT_SECRET=development-jwt-secret-key-123
JWT_ALGORITHM=HS256
COOKIE_DOMAIN=erp.local

# ─── MinIO Object Storage ────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── Service URLs (Docker internal container names) ──
IAM_API_URL=http://core-iam:8002
ERP_API_URL=http://erp-service:8000
CRM_API_URL=http://crm-service:8001
BILLING_API_URL=http://billing-service:8003
INVENTORY_API_URL=http://inventory-service:8004
AI_API_URL=http://ai-service:8005

# ─── Inter-Service URLs (backend → backend) ──────────
BILLING_SERVICE_URL=http://billing-service:8003/api
INVENTORY_SERVICE_URL=http://inventory-service:8004
CRM_SERVICE_URL=http://crm-service:8001

# ─── AI / LLM Configuration ─────────────────────────
# Provider: "groq" (default) or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here        # Free at console.groq.com
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your-gemini-api-key-here     # Free at aistudio.google.com

# ─── Frontend URLs (via nginx — .erp.local domains) ──
SHELL_APP_URL=http://app.erp.local
CRM_APP_URL=http://crm.erp.local
BILLING_APP_URL=http://billing.erp.local
INVENTORY_APP_URL=http://inventory.erp.local

# ─── Outbound proxy (Docker Desktop on corporate networks) ──
# Leave unset/empty on networks with direct internet access.
# HTTP_PROXY=http://http.docker.internal:3128
# HTTPS_PROXY=http://http.docker.internal:3128
# NO_PROXY=localhost,127.0.0.1,::1,postgres,rabbitmq,minio,core-iam,billing-service,erp-service,crm-service,inventory-service,ai-service,erp-shell,crm-shell,billing-ui,inventory-ui,nginx,.erp.local
