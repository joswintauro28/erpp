# ─────────────────────────────────────────────────────────────
# DATAVEX ERP — Local Docker Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.docker and customize as needed:
#   cp .env.docker.example .env.docker
#
# NEVER commit .env.docker with real production secrets.
# This example file IS committed as a reference template.
# ─────────────────────────────────────────────────────────────

# ─── Image Build Tags ────────────────────────────────────────
PROJECT_TAG=latest
BUILD_NUMBER=1

# ─── Deployment Mode ─────────────────────────────────────────
# "subdomain" for *.erp.local routing (default Mode A)
# "single-domain" for erp.local/crm, erp.local/billing path routing (Mode B)
DEPLOY_MODE=subdomain
MAIN_DOMAIN=erp.local

# ─── PostgreSQL Configuration ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres

# ─── RabbitMQ Message Broker ─────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── Security & Authentication ───────────────────────────────
# CRITICAL: All backend services MUST share the exact same JWT secret.
# In production, generate with: openssl rand -hex 32
JWT_SECRET=development-jwt-secret-key-123
JWT_ALGORITHM=HS256
COOKIE_DOMAIN=erp.local

# ─── RustFS Object Storage ───────────────────────────────────
# Credentials for both RustFS server and erp-service S3 client.
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
RUSTFS_SERVER_URL=http://rustfs.erp.local

# ─── Workstation Public URLs (Subdomain Mode) ────────────────
SHELL_APP_URL=http://app.erp.local
CRM_APP_URL=http://crm.erp.local
BILLING_APP_URL=http://billing.erp.local
INVENTORY_APP_URL=http://inventory.erp.local

# ─── AI / LLM Configuration ──────────────────────────────────
# Provider: "groq" (default) or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Network Configuration ───────────────────────────────────
ERP_NETWORK_NAME=datavex-erp-network

# ─── HTTP(S) Proxy (Corporate networks ONLY) ─────────────────
# ⚠️ Docker Desktop's built-in proxy (http.docker.internal)
#    is UNRELIABLE for Docker builds — it causes TLS errors
#    on Alpine CDN and connection-refused on Debian repos.
#    Leave commented out unless you have a proven working proxy.
#
# HTTP_PROXY=http://your-proxy-host:port
# HTTPS_PROXY=http://your-proxy-host:port
# NO_PROXY=localhost,127.0.0.1,::1,postgres,rabbitmq,minio,core-iam,billing-service,erp-service,crm-service,inventory-service,ai-service,erp-shell,crm-shell,billing-ui,inventory-ui,nginx,.erp.local
