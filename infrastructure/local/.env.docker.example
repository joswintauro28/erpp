# ─────────────────────────────────────────────────────
# DATAVEX ERP — Local Docker Environment Variables
# ─────────────────────────────────────────────────────

# Shared JWT Secret (MUST match across all services)
JWT_SECRET=development-jwt-secret-key-123
JWT_ALGORITHM=HS256
COOKIE_DOMAIN=erp.local

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres

# PostgreSQL connection strings (Docker container name resolution)
DB_HOST=postgres
DB_PORT=5432

# Service URLs (Docker internal container names)
IAM_API_URL=http://core-iam:8002
ERP_API_URL=http://erp-service:8000
CRM_API_URL=http://crm-service:8001
BILLING_API_URL=http://billing-service:8003
INVENTORY_API_URL=http://inventory-service:8004

# AI / LLM API Keys (optional — used by crm-service for AI Assistant)
GROQ_API_KEY=
GEMINI_API_KEY=

# Frontend URLs (via nginx — .erp.local domains)
SHELL_APP_URL=http://app.erp.local
CRM_APP_URL=http://crm.erp.local
BILLING_APP_URL=http://billing.erp.local
INVENTORY_APP_URL=http://inventory.erp.local
