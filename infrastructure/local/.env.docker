# ─────────────────────────────────────────────────────────────
# DATAVEX ERP — Docker Environment Configuration
# Copy this file to .env.docker and customize as needed
# NEVER commit .env.docker with real secrets.
# ─────────────────────────────────────────────────────────────

# ─── Image Build Tags ──────────────────────────────────────
PROJECT_TAG=test
BUILD_NUMBER=1

# ─── PostgreSQL Configuration ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres

# ─── Security & Authentication ─────────────────────────────
# CRITICAL: All backend services MUST share the same JWT secret.
JWT_SECRET=development-jwt-secret-key-123
JWT_ALGORITHM=HS256
COOKIE_DOMAIN=erp.local

# ─── MinIO Object Storage ──────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ─── Application URLs ──────────────────────────────────────
SHELL_APP_URL=http://app.erp.local
CRM_APP_URL=http://crm.erp.local
BILLING_APP_URL=http://billing.erp.local
INVENTORY_APP_URL=http://inventory.erp.local

# ─── AI / LLM Configuration ───────────────────────────────
# Provider: "groq" (default) or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Network Configuration ─────────────────────────────────
ERP_NETWORK_NAME=datavex-erp-network

# ─── HTTP(S) Proxy (Docker Desktop on corporate networks) ──
# Leave unset/empty on networks with direct internet access.
# HTTP_PROXY=http://http.docker.internal:3128
# HTTPS_PROXY=http://http.docker.internal:3128
# NO_PROXY=localhost,127.0.0.1,::1,postgres,rabbitmq,minio,core-iam,billing-service,erp-service,crm-service,inventory-service,ai-service,erp-shell,crm-shell,billing-ui,inventory-ui,nginx,.erp.local
